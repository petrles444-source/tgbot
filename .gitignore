# Ключи. Главное правило этого репозитория.
#
# Почему так строго
# ------------------
# Репозиторий публичный. Любой файл, попавший в коммит, остаётся
# там навсегда: удаление файла из последнего коммита НЕ убирает его
# из истории. Токен, однажды закоммиченный, считается скомпромети-
# рованным — его отзывают только перевыпуском у @BotFather.
#
# Поэтому ключи исключены и по имени файла, и по содержимому: даже
# если файл переименуют или положат в другую папку, он останется
# невидимым для git.

# Настоящие ключи Telegram и моделей
bots/секреты/
bots/**/секреты/
*.local.json
config.local.json

# Ключ PythonAnywhere — отдельная папка, но правило на *.local.json
# его не покрывает, поэтому запрещаем явно.
hosting/pythonanywhere/credentials.json

# На всякий случай: любой файл с «токеном» внутри не должен
# коммититься, даже если забудет исключение выше.
*.env
.env.*

# Скомпилированное и кэш
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Окружения
.venv/
venv/
env/

# Временное и мусор
tmp/
tmp*/
*.bak
*.orig
*.rej
*.log

# Папки с картинками-референсами весят 6 МБ и нужны только как
# памятка. Код их не читает.
bots/код/character/pictures-референсы/

# OS
.DS_Store
Thumbs.db
desktop.ini
# Память ботов: личные сведения собеседника.
#
# Собираются автоматически из разговора и переживают
# перезапуск. В репозиторий им нельзя даже выдуманные:
# сейчас там проверочный «Иван», через полгода будет
# настоящий человек, и он уедет в публичную историю.
bots/память/

# Временные папки pytest: создаются при каждом прогоне
# и содержат копии тестовых данных.
pytest-of-*/
